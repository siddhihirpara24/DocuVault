# Flask Application Secret Key (generate a secure random string in production)
SECRET_KEY=dev-secret-key-change-in-production-mca-project-2026

# Database Configuration (MySQL recommended)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/document_organizer_db

# Fallback: SQLite is also supported if MySQL is not yet installed:
# DATABASE_URL=sqlite:///document_organizer.db

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Application Port and Host
FLASK_APP=app.py
FLASK_DEBUG=1
